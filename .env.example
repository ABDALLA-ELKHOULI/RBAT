# Database
DATABASE_URL=postgresql://rbat_user:rbat_password@localhost:5432/rbat_db

# AI Models
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here  # Get from https://openweathermap.org/api
NASA_API_KEY=your_nasa_api_key_here  # Get from https://api.nasa.gov
NEWS_API_KEY=your_newsapi_key_here  # Get from https://newsapi.org

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Application Settings
DEBUG=False
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Saudi Arabia Settings
DEFAULT_COUNTRY=SA
DEFAULT_TIMEZONE=Asia/Riyadh
